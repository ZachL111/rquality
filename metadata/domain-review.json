{
  "repo": "rquality",
  "language": "R",
  "category": "Data quality",
  "goal": "Run table checks for nulls, ranges, uniqueness, and cross-field rules.",
  "review_model": {
    "terms": [
      "schema drift",
      "quality gap",
      "manifest risk",
      "record pressure"
    ],
    "lanes": [
      "ship",
      "watch",
      "hold"
    ],
    "score": "signal * 2 + slack + confidence - drag * 3",
